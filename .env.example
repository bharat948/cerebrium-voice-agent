# Copy to .env. NEVER COMMIT ACTUAL SECRETS.
APP_NAME=Voice Foundry
APP_ENV=development
# Key you enter in the web UI. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=dev-local-only-change-me
# true = no real phone calls; still supports an optional OpenAI-backed preview chat
DEMO_MODE=true
# PUBLIC_BASE_URL is your public HTTPS URL, no trailing slash, for live calls.
# For local hosting: example https://abcd-1234.ngrok-free.app
# On Render: auto-set via render.yaml from RENDER_EXTERNAL_URL
PUBLIC_BASE_URL=
DB_PATH=/data/voice_foundry.db

# Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURES=true
TWILIO_ALLOW_INBOUND=true
# Explicitly restrict numbers, comma separated, E.164 format. Empty means NO outbound calls.
ALLOWED_OUTBOUND_NUMBERS=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=220

# Voice runtime. openai_live = low-latency direct GPT-Live. deepgram = original STT→LLM→TTS.
# Select the engine per call in the dashboard, or set this server default.
VOICE_ENGINE=openai_live
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
# Only invoked for delegated reasoning. No business tools are enabled.
OPENAI_LIVE_BACKEND_MODEL=gpt-4o-mini
# Local μ-law RMS-based barge-in clearing of Twilio playback buffer. 0 disables.
LIVE_BARGE_IN_RMS=900
LIVE_BARGE_IN_FRAMES=5

# Deepgram: https://console.deepgram.com/
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Deepgram Aura TTS defaults below are English-only; see docs for multilingual considerations.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Call safety and lifecycle
MAX_CALL_SECONDS=300
MAX_CONCURRENT_CALLS=2
MAX_CALLS_PER_HOUR=10
# Incoming calls automatically create a default agenda; set false to reject them.
TRANSCRIPT_RETENTION_DAYS=30
