# Copy to .env. NEVER COMMIT ACTUAL SECRETS.
APP_NAME=Voice Foundry
APP_ENV=development
# Key you enter in the web UI. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=dev-local-only-change-me
# true = no real phone calls; still supports an optional OpenAI-backed preview chat
DEMO_MODE=true
# PUBLIC_BASE_URL is your public HTTPS URL, no trailing slash, for live calls.
# For local hosting: example https://abcd-1234.ngrok-free.app
# On Render: auto-set via render.yaml from RENDER_EXTERNAL_URL
PUBLIC_BASE_URL=
# Docker Compose overrides DATABASE_URL to the included pgvector PostgreSQL container.
# Local Python without Docker can leave this blank and set DB_PATH=./data/voice_foundry.db.
DATABASE_URL=
DB_PATH=./data/voice_foundry.db

# Local/demo: api_key; hosted service: google.
AUTH_MODE=api_key
SESSION_SECRET=please-generate-with-python-secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact stable Google subject from the owner's OIDC ID token (NOT their email).
GOOGLE_OWNER_SUB=
OWNER_PHONE=

# Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURES=true
TWILIO_ALLOW_INBOUND=true
# Explicitly restrict numbers, comma separated, E.164 format. Empty means NO outbound calls.
ALLOWED_OUTBOUND_NUMBERS=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=220

# Voice runtime. openai_live = low-latency direct GPT-Live. deepgram = original STT→LLM→TTS.
# Select the engine per call in the dashboard, or set this server default.
VOICE_ENGINE=openai_live
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
# Only invoked for delegated reasoning. No business tools are enabled.
OPENAI_LIVE_BACKEND_MODEL=gpt-4o-mini
# Local μ-law RMS-based barge-in clearing of Twilio playback buffer. 0 disables.
LIVE_BARGE_IN_RMS=900
LIVE_BARGE_IN_FRAMES=5

# Deepgram: https://console.deepgram.com/
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Deepgram Aura TTS defaults below are English-only; see docs for multilingual considerations.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Call safety and lifecycle
MAX_CALL_SECONDS=300
MAX_CONCURRENT_CALLS=2
MAX_CALLS_PER_HOUR=10
# Incoming calls automatically create a default agenda; set false to reject them.
TRANSCRIPT_RETENTION_DAYS=30

# Built-in tools & research emails (use dedicated app credentials, never commit secrets)
BRAVE_SEARCH_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ENABLE_BACKGROUND_WORKER=true
WORKER_POLL_SECONDS=10
# POSTGRES_PASSWORD only used by Docker Compose local DB.
POSTGRES_PASSWORD=local-dev-please-change

# Advanced v3 modules (optional when using demo mode)
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for owner-connected Google Contacts / Calendar. Keep stable across deployments.
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_IMPORT_ENABLED=false
# Financial data. Provider requires account/market entitlements for NSE/BSE quotes.
TWELVE_DATA_API_KEY=
# Estimated guardrails; billing from providers may differ from app estimates.
MONTHLY_BUDGET_USD=15
AGENT_MONTHLY_BUDGET_USD=5
ENABLE_POSTCALL_PROCESSOR=true
